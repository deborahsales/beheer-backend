// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FuncaoUsuario {
  GESTOR
  RH
  COLABORADOR
  ADMINISTRADOR
}

model Usuario {
  id Int @id @default(autoincrement())
  cpf String @unique
  nome String
  email String @unique
  senha String
  telefone String
  dataNascimento DateTime
  dataAdmissao DateTime
  dataDesligamento DateTime?
  cargo String
  funcao FuncaoUsuario @default(COLABORADOR)
  dateTimestamp DateTime @default(now())

  cronogramasGerenciados Cronograma[] @relation("GestorUsuario")
  demandasGerenciadas Demanda[] @relation("GestorDemanda")
  avisosGerenciados Aviso[] @relation("GestorRHAviso")
  comentariosPublicados Comentario[] @relation("UsuarioComentario")
  pontosUsuario Ponto[] @relation("PontoUsuario")
  prestacaoContasUsuario PrestacaoContas[] @relation("PrestacaoContasUsuario")
  atestadosUsuario Atestado[] @relation("AtestadoUsuario")
  assinaturasUsuario Assinatura[] @relation("AssinaturaUsuario")
  documentosUsuario Documento[] @relation("UsuarioDocumento")
  ajustesUsuario AjustePonto[] @relation("UsuarioAjuste")
  ajustesGerenciados GerenciamentoAjustePonto[] @relation("UsuarioGerenciamentoPonto")
  atestadosGerenciados GerenciamentoAtestado[] @relation("UsuarioGerenciamentoAtestado")
  prestacoesGerenciadas GerenciamentoPrestacao[] @relation("UsuarioGerenciamentoPrestacao")
  avisosUsuario AvisoUsuario[] @relation("UsuarioAviso")
  gruposUsuario UsuarioGrupo[] @relation("GruposUsuario")
  gruposGestor GrupoGestor[] @relation("GruposGestor")
  demandasUsuario DemandaUsuario[] @relation("UsuarioDemandas")
}

enum PrioridadeDemanda {
  BAIXA
  MEDIA
  ALTA
}

enum StatusDemanda {
  CRIADA
  INICIADA
  ATRASADA
  FINALIZADA
}

model Demanda {
  id Int @id @default(autoincrement())
  titulo String
  descricao String
  prazo DateTime?
  status StatusDemanda @default(CRIADA)
  dateTimestamp DateTime @default(now()) 
  prioridade PrioridadeDemanda

  cronogramaId  Int?
  cronograma Cronograma? @relation("CronogramaDemanda", fields: [cronogramaId], references: [id], onDelete: SetNull)

  gestorUsuarioId Int  
  gestor Usuario @relation("GestorDemanda", fields: [gestorUsuarioId], references: [id], onDelete: Cascade)

  comentariosDemanda Comentario[] @relation("DemandaComentario")
  gruposDemanda DemandaGrupo[] @relation("GrupoDemandas")
  usuariosDemanda DemandaUsuario[] @relation("DemandasUsuario")

}

model Cronograma {
  id Int @id @default(autoincrement())
  titulo String
  descricao String
  dataInicio DateTime
  dataTermino DateTime
  dateTimestamp DateTime @default(now())

  gestorUsuarioId Int
  gestor Usuario @relation("GestorUsuario", fields: [gestorUsuarioId], references: [id], onDelete: Cascade)

  demandasCronograma Demanda[] @relation("CronogramaDemanda")
}

model Aviso {
  id Int @id @default(autoincrement())
  assunto String
  conteudo String
  dateTimestamp DateTime @default(now())

  gestorRhUsuarioId Int
  gestor Usuario @relation("GestorRHAviso", fields: [gestorRhUsuarioId], references: [id], onDelete: Cascade)

  avisoUsuario AvisoUsuario[] @relation("AvisoUsuario")
  gruposAviso GruposAviso[] @relation("GruposAviso")
}

model Grupo {
  id Int @id @default(autoincrement())
  nome String
  descricao String

  usuarios UsuarioGrupo[] @relation("UsuariosGrupo")
  gestores GrupoGestor[] @relation("GestoresGrupo")
  demandas DemandaGrupo[] @relation("DemandasGrupo")
  avisosGrupo GruposAviso[] @relation("AvisosGrupo")
}

model Comentario{
  id Int @id @default(autoincrement())
  conteudo String
  dateTimestamp DateTime @default(now())
  dataAlteracao DateTime? @updatedAt

  demandaId Int
  demanda Demanda @relation("DemandaComentario", fields: [demandaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario Usuario @relation("UsuarioComentario", fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Ponto {
  id Int @id @default(autoincrement())
  dateTimestamp DateTime @default(now())
  dateTimestampAjustado DateTime?
  ip String
  imagem String
  latitude Float
  longitude Float
  ativo Boolean @default(true)

  usuarioId Int
  usuario Usuario @relation("PontoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  
  ajuste AjustePonto? @relation("PontoAjuste")
}

enum StatusPrestacao {
  CADASTRADA
  ACEITE
  RECUSADA
}

model PrestacaoContas {
  id Int @id @default(autoincrement())
  descricao String
  data DateTime
  valor Decimal
  imagem String
  dateTimestamp DateTime @default(now())
  status StatusPrestacao @default(CADASTRADA)

  usuarioId Int
  usuario Usuario @relation("PrestacaoContasUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  
  gerenciamentoPrestacao GerenciamentoPrestacao[] @relation("PrestacaoGerenciada")
}

enum DiaInteiro {
  SIM
  NAO
}

enum StatusAtestado {
  CADASTRADO
  ACEITE
  RECUSADO
}

model Atestado {
  id Int @id @default(autoincrement())
  dateTimestamp DateTime @default(now())
  dataAtestado DateTime
  horaInicio DateTime?
  horaTermino DateTime?
  diaInteiro DiaInteiro
  imagem String
  status StatusAtestado @default(CADASTRADO)

  usuarioId Int
  usuario Usuario @relation("AtestadoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  gerenciamentoAtestado GerenciamentoAtestado[] @relation("AtestadoGerenciado")
}

enum StatusAssinatura {
  ATIVA
  INATIVA
  CANCELADA
}

model Assinatura {
  id Int @id @default(autoincrement())
  assinatura String
  dateTimestamp DateTime @default(now())
  status StatusAssinatura
  ip String

  certificadoDigitalId Int
  certificadoDigital CertificadoDigital @relation("CertificadoAssinatura", fields: [certificadoDigitalId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario Usuario @relation("AssinaturaUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  documento_id Int @unique
  documento Documento @relation("AssinaturaDocumento", fields: [documento_id], references: [id], onDelete: Cascade)
}

enum StatusCertificado {
  VALIDO
  EXPIRADO
  REVOGADO
  SUSPENSO
  CANCELADO
}

model CertificadoDigital {
  id Int @id @default(autoincrement())
  certificado String
  dataEmissao DateTime
  dataValidade DateTime
  status StatusCertificado

  assinaturasCertificado Assinatura[] @relation("CertificadoAssinatura")
}

enum StatusDocumento {
  ASSINADO
  PENDENTE
}

model Documento{
  id Int @id @default(autoincrement())
  nome String
  url String
  hash String
  dateTimestamp DateTime @default(now())
  status StatusDocumento

  usuarioId Int
  usuario Usuario @relation("UsuarioDocumento", fields: [usuarioId], references: [id], onDelete: Cascade)

  assinaturaDocumento Assinatura? @relation("AssinaturaDocumento")
}

enum MotivoAjuste {
  ERRO
  DUPLICADO
}

enum StatusAjuste {
  AJUSTADO
  PENDENTE
  RECUSADO
}

model AjustePonto {
  id Int @id @default(autoincrement())
  dateTimestampAjustado DateTime?
  motivo MotivoAjuste
  status StatusAjuste @default(PENDENTE)
  dateTimestamp DateTime @default(now())

  usuarioId Int
  usuario Usuario @relation("UsuarioAjuste", fields: [usuarioId], references: [id], onDelete: Cascade)

  pontoId Int @unique
  ponto Ponto @relation("PontoAjuste", fields: [pontoId], references: [id], onDelete: Cascade)

  gerenciamentoAjuste GerenciamentoAjustePonto[] @relation("PontoAjustado")
}

model GerenciamentoAjustePonto {
  id Int @id @default(autoincrement())
  dateTimestamp DateTime @default(now())

  ajustePontoId Int
  ajustePonto AjustePonto @relation("PontoAjustado", fields: [ajustePontoId], references: [id], onDelete: Cascade)

  rhUsuarioId Int
  usuarioRh Usuario @relation("UsuarioGerenciamentoPonto", fields: [rhUsuarioId], references: [id], onDelete: Cascade)

}

model GerenciamentoAtestado {
  id Int @id @default(autoincrement())
  dateTimestamp DateTime @default(now())

  atestadoId Int
  atestado Atestado? @relation("AtestadoGerenciado", fields: [atestadoId], references: [id], onDelete: Cascade)

  rhUsuarioId Int
  usuarioRh Usuario @relation("UsuarioGerenciamentoAtestado", fields: [rhUsuarioId], references: [id], onDelete: Cascade)

}

model GerenciamentoPrestacao {
  id Int @id @default(autoincrement())
  dateTimestamp DateTime @default(now())

  prestacaoId Int
  prestacao PrestacaoContas? @relation("PrestacaoGerenciada", fields: [prestacaoId], references: [id], onDelete: Cascade)

  rhUsuarioId Int
  usuarioRh Usuario @relation("UsuarioGerenciamentoPrestacao", fields: [rhUsuarioId], references: [id], onDelete: Cascade)

}

enum StatusAviso {
  LIDO
  PENDENTE
}

model AvisoUsuario {
  status StatusAviso @default(PENDENTE)
  dataLeitura DateTime @updatedAt

  usuarioId Int
  usuario Usuario @relation("UsuarioAviso", fields: [usuarioId], references: [id], onDelete: Cascade)

  avisoId Int
  aviso Aviso @relation("AvisoUsuario", fields: [avisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, avisoId])
}

model GruposAviso {
  grupoId Int
  grupo Grupo @relation("AvisosGrupo", fields: [grupoId], references: [id], onDelete: Cascade)

  avisoId Int
  aviso Aviso @relation("GruposAviso", fields: [avisoId], references: [id], onDelete: Cascade)

  @@id([grupoId, avisoId])
}

model UsuarioGrupo {
  usuarioId Int
  usuario Usuario @relation("GruposUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  grupoId Int
  grupo Grupo @relation("UsuariosGrupo", fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, grupoId])
}

model GrupoGestor {
  usuarioId Int
  usuario Usuario @relation("GruposGestor", fields: [usuarioId], references: [id], onDelete: Cascade)

  grupoId Int
  grupo Grupo @relation("GestoresGrupo", fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, grupoId])
}

model DemandaGrupo {
  demandaId Int
  demanda Demanda @relation("GrupoDemandas", fields: [demandaId], references: [id], onDelete: Cascade)

  grupoId Int
  grupo Grupo @relation("DemandasGrupo", fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([demandaId, grupoId])
}

model DemandaUsuario {
  demandaId Int
  demanda Demanda @relation("DemandasUsuario", fields: [demandaId], references: [id], onDelete: Cascade)

  
  usuarioId Int
  usuario Usuario @relation("UsuarioDemandas", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([demandaId, usuarioId])
}